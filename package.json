{
  "name": "termiinal",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "npm run test:ts && npm run test:rust",
    "tauri": "tauri",
    "test:ts": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "pretest:rust": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
