{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "terminal-mentor",
  "version": "0.1.0",
  "identifier": "com.pakochka.terminalmentor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "terminal-mentor",
        "width": 460,
        "height": 640,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyNzEzNjFBNDlFOUI0NTUKUldSVnRPbEpHalp4Z2hFK3IzQ1JRYVUzMGtHUnptaWgzT3JwWUk0dFRROE5TQ3VVT3lMMUZIcysK",
      "endpoints": [
        "https://github.com/Pakochka/termiinal/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
